      "series": ["#E07A6B", "#E0B062", "#8FB0E0", "#9CC48A", "#C79BD0", "#86C1C7"],
      "shadow": "0 1px 2px rgb(0 0 0 / .45), 0 8px 22px rgb(0 0 0 / .4)"
