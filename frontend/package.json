{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "export-vizlang": "VIZLANG_WRITE=1 vitest run src/vizlang/__tests__/export.test.ts",
    "export-viz-style": "VIZ_STYLE_WRITE=1 vitest run src/components/visualization/theme",
